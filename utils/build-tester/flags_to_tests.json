{
  "env": "lolin_c3_mini",
  "test_flags": [
    {"id": 0,  "tier": "A", "name": "Default (no flags)",       "flags": []},
    {"id": 1,  "tier": "A", "name": "Full production config",   "flags": ["-DWIFI_DUAL_MODE=1", "-DBLE_ENABLE=1", "-DBLE_DEVICE_NAME=\\\"MyGNSS\\\"", "-DWEBUI_ENABLE=1", "-DNMEA_ENABLE=1", "-DTCP_ENABLE=1", "-DTCP_PORT=52148", "-DNTRIP_CLIENT_ENABLE=1"]},

    {"id": 10, "tier": "B", "name": "BLE only",                 "flags": ["-DBLE_ENABLE=1"]},
    {"id": 11, "tier": "B", "name": "TCP only",                 "flags": ["-DTCP_ENABLE=1"]},
    {"id": 12, "tier": "B", "name": "WEBUI + NMEA",             "flags": ["-DWEBUI_ENABLE=1", "-DNMEA_ENABLE=1"]},
    {"id": 13, "tier": "B", "name": "WEBUI + NTRIP",            "flags": ["-DWEBUI_ENABLE=1", "-DNTRIP_CLIENT_ENABLE=1"]},
    {"id": 14, "tier": "B", "name": "BLE + WEBUI + TCP",        "flags": ["-DBLE_ENABLE=1", "-DWEBUI_ENABLE=1", "-DTCP_ENABLE=1"]},
    {"id": 15, "tier": "B", "name": "WEBUI + NMEA + TCP + NTRIP", "flags": ["-DWEBUI_ENABLE=1", "-DNMEA_ENABLE=1", "-DTCP_ENABLE=1", "-DNTRIP_CLIENT_ENABLE=1"]},
    {"id": 16, "tier": "B", "name": "TCP custom port",          "flags": ["-DTCP_ENABLE=1", "-DTCP_PORT=52148"]},
    {"id": 17, "tier": "B", "name": "BLE custom name + MTU",    "flags": ["-DBLE_ENABLE=1", "-DBLE_DEVICE_NAME=\\\"MyGNSS\\\"", "-DBLE_MTU_CFG=185"]},
    {"id": 18, "tier": "B", "name": "Higher GNSS rate",         "flags": ["-DGNSS_HZ_CFG=10"]},
    {"id": 19, "tier": "B", "name": "Hardcoded UART + WEBUI",   "flags": ["-DWEBUI_ENABLE=1", "-DFORCE_HARDCODED_UART=1", "-DHARD_RX_PIN=20", "-DHARD_TX_PIN=21", "-DHARD_BAUD=115200"]},
    {"id": 22, "tier": "B", "name": "NTRIP task disabled",      "flags": ["-DWEBUI_ENABLE=1", "-DNTRIP_CLIENT_ENABLE=1", "-DNTRIP_CLIENT_ENABLE_TASK=0"]},
    {"id": 23, "tier": "B", "name": "NTRIP Rev1 fallback off",  "flags": ["-DWEBUI_ENABLE=1", "-DNTRIP_CLIENT_ENABLE=1", "-DNTRIP_CLIENT_ENABLE_REV1_FALLBACK=0"]},
    {"id": 24, "tier": "B", "name": "NTRIP passive scan tuned", "flags": ["-DWEBUI_ENABLE=1", "-DNTRIP_CLIENT_ENABLE=1", "-DNTRIP_CLIENT_PASSIVE_SCAN_BYTES=64"]},
    {"id": 25, "tier": "B", "name": "WiFi dual mode enabled",   "flags": ["-DWEBUI_ENABLE=1", "-DWIFI_DUAL_MODE=1"]},
    {"id": 26, "tier": "B", "name": "WiFi dual mode + STA channel", "flags": ["-DWEBUI_ENABLE=1", "-DWIFI_DUAL_MODE=1", "-DSTA_CHANNEL=6"]},
    {"id": 27, "tier": "B", "name": "WiFi dual mode + custom SoftAP", "flags": ["-DWEBUI_ENABLE=1", "-DWIFI_DUAL_MODE=1", "-DSOFTAP_SSID_VALUE=\\\"GNSS-LAB\\\"", "-DSOFTAP_PASS_VALUE=\\\"pass12345\\\"", "-DSOFTAP_CHANNEL=11", "-DSOFTAP_HIDDEN=0", "-DSOFTAP_MAX_CONN=4"]},

    {"id": 30, "tier": "C", "name": "NTRIP with WiFi forced off (must fail)", "flags": ["-DNTRIP_CLIENT_ENABLE=1", "-DWIFI_ENABLE=0"], "expect": "fail"},
    {"id": 31, "tier": "C", "name": "TCP with WiFi forced off (must fail)", "flags": ["-DTCP_ENABLE=1", "-DWIFI_ENABLE=0"], "expect": "fail"},
    {"id": 32, "tier": "C", "name": "WEBUI with WiFi forced off (must fail)", "flags": ["-DWEBUI_ENABLE=1", "-DWIFI_ENABLE=0"], "expect": "fail"},
    {"id": 33, "tier": "C", "name": "Hardcoded UART without pins (must fail)", "flags": ["-DFORCE_HARDCODED_UART=1"], "expect": "fail"},
    {"id": 34, "tier": "C", "name": "Hardcoded UART missing HARD_BAUD (must fail)", "flags": ["-DFORCE_HARDCODED_UART=1", "-DHARD_RX_PIN=20", "-DHARD_TX_PIN=21"], "expect": "fail"},
    {"id": 35, "tier": "C", "name": "Hardcoded UART missing HARD_TX_PIN (must fail)", "flags": ["-DFORCE_HARDCODED_UART=1", "-DHARD_RX_PIN=20", "-DHARD_BAUD=115200"], "expect": "fail"},
    {"id": 36, "tier": "C", "name": "Hardcoded UART missing HARD_RX_PIN (must fail)", "flags": ["-DFORCE_HARDCODED_UART=1", "-DHARD_TX_PIN=21", "-DHARD_BAUD=115200"], "expect": "fail"}
  ]
}
