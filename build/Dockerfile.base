# build/Dockerfile.base
FROM python:3.12-slim

WORKDIR /project

# Install PlatformIO Core
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir platformio esptool

# Install Global Toolchains (The heavy part)
# This layer is now baked into the 'gnss-base' image
RUN --mount=type=cache,target=/root/.platformio/.cache \
    pio pkg install -g -p "espressif32 @ 6.12.0" && \
    pio pkg install -g -t "espressif/toolchain-riscv32-esp @ 8.4.0+2021r2-patch5" && \
    pio pkg install -g -t "platformio/framework-arduinoespressif32 @ ~3.20017.0" && \
    pio pkg install -g -t "platformio/tool-esptoolpy @ 2.41100.0" && \
    pio pkg install -g -t "platformio/tool-mklittlefs @ 1.203.210628" && \
    pio pkg install -g -l "h2zero/NimBLE-Arduino @ 2.3.7" && \
    pio pkg install -g -l "bblanchon/ArduinoJson @ 7.4.2"

# No ENTRYPOINT yet, this is just an environment